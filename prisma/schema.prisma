generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  role         String        @default("user")
  createdAt    DateTime      @default(now())

  applications Application[]
}

model Job {
  id          String   @id @default(uuid())
  title       String
  company     String
  location    String?
  remote      Boolean  @default(true)
  url         String
  source      String
  description String?
  tags        String[]
  createdAt   DateTime @default(now())

  applications Application[]
}

model Application {
  id              String   @id @default(uuid())
  userId          String
  jobId           String?
  externalTitle   String?
  externalCompany String?
  source          String
  status          String   @default("saved")
  notes           String?
  appliedAt       DateTime @default(now())
  followUpDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  job  Job? @relation(fields: [jobId], references: [id])
}

model IngestionEngine {
  id         String   @id @default(uuid())
  paused     Boolean  @default(false)
  running    Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model IngestionSource {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  enabled     Boolean  @default(true)
  healthy     Boolean  @default(true)
  lastRunAt   DateTime?
  successRate Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IngestionRun {
  id          String   @id @default(uuid())
  sourceName  String?
  status      String
  fetched     Int      @default(0)
  saved       Int      @default(0)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  message     String?
}

model IngestionLog {
  id         String   @id @default(uuid())
  level      String
  sourceName String?
  message    String
  createdAt  DateTime @default(now())
}

model Company {
  id               String   @id @default(uuid())
  name             String   @unique
  website          String?
  logoUrl          String?
  careersUrl       String
  atsType          String
  tags             String[]
  enabled          Boolean  @default(true)
  priority         Int      @default(1)
  healthy          Boolean  @default(true)
  lastCheckedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CompanyLog {
  id          String   @id @default(uuid())
  companyId   String
  level       String
  message     String
  createdAt   DateTime @default(now())
}